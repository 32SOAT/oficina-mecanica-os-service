NODE_ENV=development
APP_PORT=3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina123
POSTGRES_DB=oficina_os
POSTGRES_SYNC=0
POSTGRES_SSL=0
POSTGRES_SSL_REJECT_UNAUTHORIZED=0

JWT_SECRET=oficina-local-secret
JWT_EXPIRES_IN=1h

RESEND_API_KEY=re_local
RESEND_FROM=onboarding@resend.dev
NOTIFICACAO_EMAIL_MECANICOS=oficina@example.com
NOTIFICACAO_EMAIL_ADMIN=oficina@example.com

BILLING_BASE_URL=http://localhost:3002
EXECUCAO_BASE_URL=http://localhost:3003
SAGA_TOKEN=oficina-local
BUSINESS_METRICS_ENABLED=false

SQS_ENDPOINT_URL=http://localhost:4566
SQS_REGION=us-east-1
SQS_BILLING_COMMAND_QUEUE_URL=http://localhost:4566/000000000000/oficina-billing-commands.fifo
SQS_EXECUTION_COMMAND_QUEUE_URL=http://localhost:4566/000000000000/oficina-execution-commands.fifo
SQS_RESULTS_QUEUE_URL=http://localhost:4566/000000000000/oficina-os-results.fifo
SQS_OUTBOX_RELAY_ENABLED=true
SQS_RESULTS_CONSUMER_ENABLED=true
SQS_OUTBOX_POLL_INTERVAL_MS=1000
SQS_OUTBOX_BATCH_SIZE=10
SQS_OUTBOX_LEASE_MS=30000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
